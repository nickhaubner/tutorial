---
interface Props {
  text: string;
  class?: string;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'p' | 'span' | 'div';
  /** seconds between each character */
  step?: number;
  /** seconds for each character's animation */
  duration?: number;
}

const {
  text,
  class: className = '',
  as: Tag = 'h1',
  step = 0.045,
  duration = 0.7,
} = Astro.props;

const chars = [...text];
---

<Tag
  class={`stagger-fade ${className}`}
  style={`--step:${step}s; --duration:${duration}s`}
  aria-label={text}
>
  {chars.map((char, i) => (
    <span aria-hidden="true" style={`--i:${i}`}>
      {char === ' ' ? '\u00A0' : char}
    </span>
  ))}
</Tag>

<style>
  .stagger-fade {
    /* keep inline-block so transforms on children don't break line wrapping weirdly */
    display: inline-block;
  }

  .stagger-fade span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    filter: blur(6px);
    will-change: opacity, transform, filter;
    animation: stagger-fade-in var(--duration, 0.7s)
      cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: calc(var(--i) * var(--step, 0.045s));
  }

  @keyframes stagger-fade-in {
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  /* respect users who don't want motion */
  @media (prefers-reduced-motion: reduce) {
    .stagger-fade span {
      animation: none;
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
</style>